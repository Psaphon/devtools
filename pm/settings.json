{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Skill(status)",
      "Skill(handoff)",
      "Skill(kickoff)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(gh pr*)",
      "Bash(gh run*)",
      "Bash(gh api*)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh workflow*)",
      "Bash(dtl*)",
      "Bash(ruff*)",
      "Bash(pytest*)",
      "Bash(python3*)",
      "Bash(make *)",
      "Bash(bats*)",
      "Bash(shellcheck*)",
      "Bash(systemctl --user*)",
      "Bash(journalctl --user*)",
      "Bash(systemd-analyze*)",
      "Bash(mkdir -p*)",
      "Bash(ls*)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(pgrep*)"
    ],
    "deny": [
      "Bash(sudo*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push * main*)",
      "Bash(git push * develop*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git commit*--no-verify*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env*)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat /home/comp/Projects/.claude/HANDOFF.md 2>/dev/null || echo '[handoff missing — run snapshot commands manually]'"
          }
        ]
      }
    ]
  }
}
